#
# 首次刷机（非升级）时启用 iStoreOS 的常驻服务。
#
# 2026-09-22 移除 quickstart 栈后，本脚本只剩三个职责：
#   1) ttyd / wifi_default / tasks 自启（这些包自带 init 脚本，
#      但 PKG_UPGRADE=0 即全新刷机时 init 不会无条件 enable）
#   2) 清掉 LuCI 菜单缓存，确保新装的入口立即生效
#
# 注：samba4 / ksmbd / minidlna / hd-idle / docker 等 luci-app 自带的服务
# 已于 2026-09-20 整批移除；enable_one 自带 -x 守卫（脚本不在就跳过），
# 将来经 iStore 商店装回相应包后重置配置即可恢复自启。

enable_one() {
	s="$1"; shift
	[ -x "/etc/init.d/$s" ] || return 0

	/etc/init.d/"$s" enable >/dev/null 2>&1

	# enable 万一没成功（脚本被改坏等），按 START 值手工补软链
	if ! ls /etc/rc.d/S??"$s" >/dev/null 2>&1; then
		start=$(sed -n 's/^START=\([0-9]*\).*/\1/p' "/etc/init.d/$s" | head -1)
		[ -n "$start" ] || start=95
		ln -sf "/etc/init.d/$s" "/etc/rc.d/S${start}${s}" 2>/dev/null
	fi

	/etc/init.d/"$s" "$@" >/dev/null 2>&1
	return 0
}

# 应用商店 / 任务队列（luci-app-store 依赖 taskd 即 tasks 二进制）
enable_one tasks start

# 终端（截图中「服务 > 终端」）
enable_one ttyd start

# 首次开机自动开 WiFi（2026-09-21 由 uci-defaults 改为 init 脚本：
# 无线配置由 ieee80211 hotplug 在 kmodloader 之后才生成，uci-defaults
# 阶段存在竞速。此处立即 start 一次，S99 软链兜底同一轮开机生效。）
enable_one wifi_default start

# 清理 LuCI 菜单缓存，确保新注册的入口立即生效
rm -f /tmp/luci-indexcache /tmp/luci-indexcache.*

exit 0
